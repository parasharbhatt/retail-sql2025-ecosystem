table DimDate
    lineageTag: 0aa11f79-aef1-4e9e-816f-9f14083ecac4
    dataCategory: Time

    column Date
        dataType: dateTime
        isKey
        formatString: mmmm d, yyyy
        sourceColumn: Date
        summarizeBy: none

    column Year
        dataType: int64
        formatString: 0
        sourceColumn: Year
        summarizeBy: none

    column Quarter
        dataType: string
        sourceColumn: Quarter
        summarizeBy: none

    column Month
        dataType: string
        sourceColumn: Month
        sortByColumn: MonthNumber
        summarizeBy: none

    column MonthNumber
        dataType: int64
        isHidden
        formatString: 0
        sourceColumn: MonthNumber
        summarizeBy: none

    column MonthYear
        dataType: string
        sourceColumn: MonthYear
        sortByColumn: YearMonthKey
        summarizeBy: none

    column YearMonthKey
        dataType: int64
        isHidden
        formatString: 0
        sourceColumn: YearMonthKey
        summarizeBy: none

    partition DimDate = m
        mode: import
        source =
            let
                FirstDate = Date.From(List.Min(FactSales[OrderDate])),
                LastDate = Date.From(List.Max(FactSales[OrderDate])),
                DateCount = Duration.Days(LastDate - FirstDate) + 1,
                Dates = List.Dates(FirstDate, DateCount, #duration(1, 0, 0, 0)),
                DateTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
                TypedDate = Table.TransformColumnTypes(DateTable, {{"Date", type date}}),
                AddYear = Table.AddColumn(TypedDate, "Year", each Date.Year([Date]), Int64.Type),
                AddQuarter = Table.AddColumn(AddYear, "Quarter", each "Q" & Number.ToText(Date.QuarterOfYear([Date])), type text),
                AddMonth = Table.AddColumn(AddQuarter, "Month", each Date.ToText([Date], "MMM", "en-US"), type text),
                AddMonthNumber = Table.AddColumn(AddMonth, "MonthNumber", each Date.Month([Date]), Int64.Type),
                AddMonthYear = Table.AddColumn(AddMonthNumber, "MonthYear", each Date.ToText([Date], "MMM yyyy", "en-US"), type text),
                AddYearMonthKey = Table.AddColumn(AddMonthYear, "YearMonthKey", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type)
            in
                AddYearMonthKey
