{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "sales_trend",
  "position": { "x": 24, "y": 170, "z": 0, "height": 250, "width": 760 },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": { "Column": { "Expression": { "SourceRef": { "Entity": "DimDate" } }, "Property": "MonthYear" } },
              "queryRef": "DimDate.MonthYear"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "all_measures" } }, "Property": "Sales Amount" } },
              "queryRef": "all_measures.Sales Amount"
            }
          ]
        }
      }
    }
  }
}
