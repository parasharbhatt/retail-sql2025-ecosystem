{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "category_units",
  "position": { "x": 650, "y": 350, "z": 0, "height": 300, "width": 606 },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": { "Column": { "Expression": { "SourceRef": { "Entity": "DimProducts" } }, "Property": "Category" } },
              "queryRef": "DimProducts.Category"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "all_measures" } }, "Property": "Total Quantity" } },
              "queryRef": "all_measures.Total Quantity"
            }
          ]
        }
      }
    }
  }
}
